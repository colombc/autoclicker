{
  "name": "kamclick",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "build:ui": "ng build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:ui && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "concurrently -k -n ui,main,app \"ng serve\" \"tsc -p tsconfig.electron.json -w --preserveWatchOutput\" \"wait-on http://localhost:4200 dist-electron/electron/main.js && electron . --dev-url=http://localhost:4200\"",
    "test": "ng test --watch=false",
    "dist": "npm run build && electron-builder --win portable --x64"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "koffi": "3.3.8"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/roboto": "5.3.0",
    "@types/node": "24.19.3",
    "concurrently": "10.0.7",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "jsdom": "^31.0.0",
    "material-symbols": "0.49.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "9.5.1"
  },
  "description": "KamClick 2 : autoclicker (réécriture de KamClick V1.2, 2011)",
  "author": "Kam",
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "fr.kamsoft.kamclick",
    "productName": "KamClick",
    "files": [
      "dist-electron/**/*",
      "dist/kamclick/browser/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "KamClick-${version}.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
